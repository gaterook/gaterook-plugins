<?xml version="1.0" encoding="UTF-8"?>
<!--
  ClickHouse as a connector module (docs/module-architecture.md): six read-only tools over ClickHouse's HTTP
  interface. The connector API and Jackson are provided by the module host (parent-first); HTTP goes through the
  host's guarded ExecContext.egress(). The module brings no library.

  The package is clickhouse-<version>.jar. Its manifest is written by ModuleManifests from module.json and from what
  the connector says of itself (src/main/resources/connectors/clickhouse/connector.json). The module's version is
  module.json's and changes only when the package does (tools/modules.mjs); the fixed outputTimestamp of the parent
  makes the build reproducible, so the SHA-256 the signed list pins can be compared with a rebuild.
  ClickHouseModuleHostIT loads that JAR in a real module host after `package`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gaterook</groupId>
    <artifactId>gaterook-modules</artifactId>
    <version>1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>modules-clickhouse</artifactId>
  <name>GateRook · Modules · ClickHouse</name>

  <properties>
    <!-- The version of module.json; tools/modules.mjs keeps the two equal. -->
    <module.version>1.0.0</module.version>
  </properties>

  <dependencies>
    <!-- The host serves both parent-first: a module never ships its own copy (the installer refuses one). -->
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver3</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Build time and tests only, never part of the package: ModuleManifests writes the manifest from the module's
      connector, and the tests read it as the core and the host do.
    -->
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>clickhouse-${module.version}</finalName>
    <resources>
      <!-- The connector's version is the build's own (@module.version@ in connector.json). -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The manifest, written from the connector the module class gives (the parent pom has the step). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <!--
        The package is the connector's own classes: it brings no library. It is still put together by the shade
        plugin, as every module's is, so that nothing of the build itself goes into it: no manifest and no Maven
        descriptor, which would carry the versions of the build's tools. The package's bytes then change only when
        the module does.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.gaterook:modules-clickhouse</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The module host ClickHouseModuleHostIT starts (the parent pom has the step). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <!-- After package: the release JAR in a real module host (ClickHouseModuleHostIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <gateway.clickhouseJar>${project.build.directory}/${project.build.finalName}.jar</gateway.clickhouseJar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
