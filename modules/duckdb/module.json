{
  "id": "duckdb",
  "version": "2.0.1",
  "name": "DuckDB",
  "provider": "GateRook",
  "license": "Apache-2.0",
  "description": "A DuckDB database file on this computer: read-only queries with row, memory and time limits; changes wait for approval.",
  "moduleClass": "com.gaterook.connectors.duckdb.DuckDbModule",
  "requires": {
    "gateway": ">=2.0.0 & <3.0.0",
    "connectorApi": ">=2.0.0 & <3.0.0",
    "javaModules": [
      "java.sql"
    ]
  },
  "access": {
    "hosts": [],
    "commands": [],
    "files": [
      "chosen in each connection"
    ]
  },
  "resources": {
    "maxHeapMb": 256,
    "maxMetaspaceMb": 128,
    "maxInFlight": 8
  }
}
