{
  "id": "msaccess",
  "version": "2.0.1",
  "name": "Microsoft Access",
  "provider": "GateRook",
  "license": "Apache-2.0",
  "description": "A Microsoft Access .accdb or .mdb file on this computer: read-only queries with row and time limits; changes wait for approval.",
  "moduleClass": "com.gaterook.connectors.access.AccessModule",
  "requires": {
    "gateway": ">=2.0.0 & <3.0.0",
    "connectorApi": ">=2.0.0 & <3.0.0",
    "javaModules": [
      "java.sql",
      "java.logging"
    ]
  },
  "access": {
    "hosts": [],
    "commands": [],
    "files": [
      "chosen in each connection"
    ]
  },
  "resources": {
    "maxHeapMb": 512,
    "maxMetaspaceMb": 128,
    "maxInFlight": 8
  }
}
