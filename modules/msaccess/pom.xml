<?xml version="1.0" encoding="UTF-8"?>
<!--
  Microsoft Access as a connector module (docs/module-architecture.md): one .accdb or .mdb file on this computer,
  read through UCanAccess with the file opened read-only and HSQLDB in a read-only transaction, and changed only by
  an approved statement on a separate copy that writes the file. The connector API and Jackson are provided by the
  module host (parent-first).

  The package is one JAR, so UCanAccess, Jackcess and HSQLDB are shaded into it unmodified, with their licenses
  (META-INF/LICENSE.txt, NOTICE.txt, hsqldb_lic.txt, hypersonic_lic.txt and META-INF/LICENSE-Access-module.txt, which
  says which is whose).

  The package is msaccess-<version>.jar. Its manifest is written by ModuleManifests from module.json and from what
  the connector says of itself (src/main/resources/connectors/msaccess/connector.json). The module's version is
  module.json's and changes only when the package does (tools/modules.mjs); the fixed outputTimestamp of the parent
  makes the build reproducible, so the SHA-256 the signed list pins can be compared with a rebuild.
  AccessModuleHostIT loads that JAR in a real module host after `package`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gaterook</groupId>
    <artifactId>gaterook-modules</artifactId>
    <version>1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>modules-msaccess</artifactId>
  <name>GateRook · Modules · Microsoft Access</name>

  <properties>
    <!-- The version of module.json; tools/modules.mjs keeps the two equal. -->
    <module.version>2.0.1</module.version>
  </properties>

  <dependencies>
    <!-- The host serves both parent-first: a module never ships its own copy (the installer refuses one). -->
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Shaded into the package, unmodified, with Jackcess and HSQLDB. -->
    <dependency>
      <groupId>io.github.spannm</groupId>
      <artifactId>ucanaccess</artifactId>
    </dependency>
    <!-- The HSQLDB UCanAccess 5.3.0 is built and tested with (hsqldb.version of the parent). -->
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Build time and tests only, never part of the package: ModuleManifests writes the manifest from the module's
      connector, and the tests read it as the core and the host do.
    -->
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>msaccess-${module.version}</finalName>
    <resources>
      <!-- The connector's version is the build's own (@module.version@ in connector.json). -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The manifest, written from the connector the module class gives (the parent pom has the step). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>io.github.spannm:ucanaccess</include>
                  <include>io.github.spannm:jackcess</include>
                  <include>org.hsqldb:hsqldb</include>
                </includes>
              </artifactSet>
              <filters>
                <!--
                  Nothing of the build itself goes into the package: no manifest and no Maven descriptor, which would
                  carry the versions of the build's tools. The package's bytes then change only when the module does.
                -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.github.spannm:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.hsqldb:hsqldb</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- UCanAccess and HSQLDB both register a JDBC driver. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The module host AccessModuleHostIT starts (the parent pom has the step). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <!-- After package: the release JAR in a real module host (AccessModuleHostIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <gateway.accessJar>${project.build.directory}/${project.build.finalName}.jar</gateway.accessJar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
