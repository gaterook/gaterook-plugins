<?xml version="1.0" encoding="UTF-8"?>
<!--
  H2 as a connector module (docs/module-architecture.md): an H2 database server over H2's TCP protocol. The H2 client
  opens its own sockets, which the module host's TCP gate lets reach only the connection's host and port (access.tcp
  of module.json), under the environment's policy. Reads are checked statements that are always rolled back; a change
  runs one approved statement. The connector API and Jackson are provided by the module host (parent-first).

  The package is one JAR, so H2's unmodified classes are shaded into it, with H2's license (MPL 2.0 or EPL 1.0) and
  where its source is (META-INF/NOTICE-H2.txt).

  The package is h2-<version>.jar. Its manifest is written by ModuleManifests from module.json and from what the
  connector says of itself (src/main/resources/connectors/h2/connector.json). The module's version is module.json's
  and changes only when the package does (tools/modules.mjs); the fixed outputTimestamp of the parent makes the build
  reproducible, so the SHA-256 the signed list pins can be compared with a rebuild. H2ModuleHostIT loads that JAR in
  a real module host after `package`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gaterook</groupId>
    <artifactId>gaterook-modules</artifactId>
    <version>1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>modules-h2</artifactId>
  <name>GateRook · Modules · H2</name>

  <properties>
    <!-- The version of module.json; tools/modules.mjs keeps the two equal. -->
    <module.version>1.1.0</module.version>
  </properties>

  <dependencies>
    <!-- The host serves both parent-first: a module never ships its own copy (the installer refuses one). -->
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>connector-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Shaded into the package, unmodified. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Build time and tests only, never part of the package: ModuleManifests writes the manifest from the module's
      connector, and the tests read it as the core and the host do.
    -->
    <dependency>
      <groupId>com.gaterook</groupId>
      <artifactId>plugin-protocol</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>h2-${module.version}</finalName>
    <resources>
      <!-- The connector's version is the build's own (@module.version@ in connector.json). -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- The manifest, written from the connector the module class gives (the parent pom has the step). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.h2database:h2</include>
                </includes>
              </artifactSet>
              <filters>
                <!--
                  Nothing of the build itself goes into the package: no manifest and no Maven descriptor, which would
                  carry the versions of the build's tools. The package's bytes then change only when the module does.
                -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.h2database:h2</artifact>
                  <includes>
                    <include>org/h2/**</include>
                    <include>META-INF/services/java.sql.Driver</include>
                  </includes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The module host H2ModuleHostIT starts (the parent pom has the step). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <!-- After package: the release JAR in a real module host (H2ModuleHostIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <gateway.h2Jar>${project.build.directory}/${project.build.finalName}.jar</gateway.h2Jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
